    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch APP",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/minurl",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config",
                "${workspaceFolder}/config.yaml"
            ]
        },
        {
            "name": "Launch Example Client",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/example-minurl-client",
            "cwd": "${workspaceFolder}",
            "args": []
        },
    ]
}
